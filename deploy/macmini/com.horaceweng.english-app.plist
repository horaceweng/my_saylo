<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.horaceweng.english-app</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/horacemac/IT/English/english-app/scripts/start-prod.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/horacemac/IT/English/english-app</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/horacemac</string>
        <key>PATH</key>
        <string>/Users/horacemac/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- On demand: launchd listens on 127.0.0.1:8000 and starts the app on the first connection; the app exits by
         itself after 15 idle minutes (backend/app/ondemand.py), so nothing runs while nobody uses it. -->
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockNodeName</key>
            <string>127.0.0.1</string>
            <key>SockServiceName</key>
            <string>8000</string>
            <key>SockType</key>
            <string>stream</string>
            <key>SockFamily</key>
            <string>IPv4</string>
        </dict>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/horacemac/Library/Logs/EnglishApp/out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/horacemac/Library/Logs/EnglishApp/err.log</string>
</dict>
</plist>
